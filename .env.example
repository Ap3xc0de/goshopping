# ── Database ──
DB_HOST=localhost
DB_PORT=5432
DB_USER=goshopping
DB_PASSWORD=localdev123
DB_NAME=goshopping
DB_SSL_MODE=disable

# ── Auth ──
JWT_SECRET=local-dev-secret-change-in-production
JWT_ACCESS_EXPIRY=15m
JWT_REFRESH_EXPIRY=168h

# ── AWS (solo para desarrollo local - en prod se usa IAM roles) ──
AWS_REGION=us-east-1
AWS_ACCESS_KEY_ID=local-dev
AWS_SECRET_ACCESS_KEY=local-dev

# ── SQS (en local usamos ElasticMQ) ──
SQS_ENDPOINT=http://localhost:9324
SQS_ORDER_EVENTS_URL=http://localhost:9324/queue/order-events
SQS_PAYMENT_EVENTS_URL=http://localhost:9324/queue/payment-events
SQS_ACCOUNTING_EVENTS_URL=http://localhost:9324/queue/accounting-events
SQS_NOTIFICATION_EVENTS_URL=http://localhost:9324/queue/notification-events
SQS_MARKETING_EVENTS_URL=http://localhost:9324/queue/marketing-events

# ── S3 ──
S3_BUCKET_ASSETS=goshopping-assets-dev
S3_ENDPOINT=http://localhost:4566

# ── Services ──
CORE_API_URL=http://localhost:3000
INTEGRATIONS_API_URL=http://localhost:3001
AI_ENGINE_API_URL=http://localhost:3002

# ── Environment ──
APP_ENV=development
PORT=3000
LOG_LEVEL=debug
